{
  "manifest_version": 3,
  "name": "Curvonomics by Curv",
  "version": "1.2.0",
  "description": "Flips chat so the message input sits up top.\n\nWorks on Chat, Claude, Gemini.\n\ncurvlabs.io",
  "homepage_url": "https://curvlabs.io",
  "icons": {
    "16": "icons/icon-on-16.png",
    "48": "icons/icon-on-48.png",
    "128": "icons/icon-on-128.png"
  },
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Curvonomics by Curv",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-on-16.png",
      "48": "icons/icon-on-48.png",
      "128": "icons/icon-on-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "css": ["style.css"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
